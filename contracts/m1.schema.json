{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cec.local/contracts/m1-v1",
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "basis",
        "source"
      ],
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 400,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "basis": {
          "enum": [
            "founder_statement",
            "artifact_observation",
            "assumption",
            "unknown"
          ]
        },
        "source": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 400,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "foundation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "stage",
        "contactState",
        "targetUser",
        "buyer",
        "problem",
        "trigger",
        "workaround",
        "desiredOutcome",
        "solution",
        "constraints",
        "unknowns"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "\\S"
        },
        "stage": {
          "enum": [
            "idea",
            "building",
            "pilot",
            "live",
            "unknown"
          ]
        },
        "contactState": {
          "enum": [
            "none_reported",
            "contact_reported",
            "unknown"
          ]
        },
        "targetUser": {
          "$ref": "#/$defs/claim"
        },
        "buyer": {
          "$ref": "#/$defs/claim"
        },
        "problem": {
          "$ref": "#/$defs/claim"
        },
        "trigger": {
          "$ref": "#/$defs/claim"
        },
        "workaround": {
          "$ref": "#/$defs/claim"
        },
        "desiredOutcome": {
          "$ref": "#/$defs/claim"
        },
        "solution": {
          "$ref": "#/$defs/claim"
        },
        "constraints": {
          "type": "array",
          "minItems": 0,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400,
            "pattern": "\\S"
          }
        },
        "unknowns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400,
            "pattern": "\\S"
          }
        }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "method",
        "journey",
        "criticalUnknown",
        "why",
        "nextAction",
        "capabilities",
        "keep",
        "park",
        "technicalAcceptance",
        "learningAcceptance",
        "observationWindow",
        "cashSpend"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180,
          "pattern": "\\S"
        },
        "method": {
          "enum": [
            "build",
            "learning"
          ]
        },
        "journey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "pattern": "\\S"
        },
        "criticalUnknown": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "pattern": "\\S"
        },
        "why": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "pattern": "\\S"
        },
        "nextAction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "pattern": "\\S"
        },
        "capabilities": {
          "type": "array",
          "minItems": 0,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400,
            "pattern": "\\S"
          }
        },
        "keep": {
          "type": "array",
          "minItems": 0,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400,
            "pattern": "\\S"
          }
        },
        "park": {
          "type": "array",
          "minItems": 0,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400,
            "pattern": "\\S"
          }
        },
        "technicalAcceptance": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400,
            "pattern": "\\S"
          }
        },
        "learningAcceptance": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400,
            "pattern": "\\S"
          }
        },
        "observationWindow": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180,
          "pattern": "\\S"
        },
        "cashSpend": {
          "const": 0
        }
      }
    },
    "draft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "synthetic",
        "expectedVersion",
        "foundation",
        "proposal",
        "artifacts",
        "artifactPermission"
      ],
      "properties": {
        "contractVersion": {
          "const": 1
        },
        "synthetic": {
          "const": true
        },
        "expectedVersion": {
          "type": "integer",
          "minimum": 0
        },
        "foundation": {
          "$ref": "#/$defs/foundation"
        },
        "proposal": {
          "$ref": "#/$defs/proposal"
        },
        "artifacts": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "pattern": "\\S"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "artifactPermission": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "granted",
            "quote"
          ],
          "properties": {
            "granted": {
              "type": "boolean"
            },
            "quote": {
              "type": "string",
              "maxLength": 500
            }
          }
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "draftHash",
        "founderApproved",
        "approvalQuote"
      ],
      "properties": {
        "contractVersion": {
          "const": 1
        },
        "draftHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "founderApproved": {
          "const": true
        },
        "approvalQuote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "cycleId",
        "implementation",
        "changes",
        "checks",
        "runInstructions",
        "gaps",
        "reportedBy"
      ],
      "properties": {
        "contractVersion": {
          "const": 1
        },
        "cycleId": {
          "type": "string",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "implementation": {
          "enum": [
            "completed",
            "partial",
            "not_started",
            "not_applicable"
          ]
        },
        "changes": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "kind"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "pattern": "\\S"
              },
              "kind": {
                "enum": [
                  "created",
                  "modified",
                  "deleted"
                ]
              }
            }
          }
        },
        "checks": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "command",
              "executed",
              "exitCode",
              "result",
              "output"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "\\S"
              },
              "command": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "\\S"
              },
              "executed": {
                "type": "boolean"
              },
              "exitCode": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "result": {
                "enum": [
                  "passed",
                  "failed",
                  "not_run"
                ]
              },
              "output": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000,
                "pattern": "\\S"
              }
            }
          }
        },
        "runInstructions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400,
            "pattern": "\\S"
          }
        },
        "gaps": {
          "type": "array",
          "minItems": 0,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400,
            "pattern": "\\S"
          }
        },
        "reportedBy": {
          "const": "codex"
        }
      }
    },
    "inspect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paths",
        "permissionGranted",
        "permissionQuote"
      ],
      "properties": {
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "\\S"
          }
        },
        "permissionGranted": {
          "const": true
        },
        "permissionQuote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        }
      }
    }
  }
}
