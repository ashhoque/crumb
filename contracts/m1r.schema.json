{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pruvity.local/contracts/m1r-v2",
  "$defs": {
    "text": {"type":"string","minLength":1,"maxLength":400,"pattern":"\\S"},
    "nullableText": {"anyOf":[{"$ref":"#/$defs/text"},{"type":"null"}]},
    "draft": {
      "type":"object","additionalProperties":false,
      "required":["contractVersion","synthetic","expectedVersion","foundation","proposal","artifacts","artifactPermission","ideal","brief"],
      "properties": {
        "contractVersion":{"const":2}, "synthetic":{"const":true},
        "expectedVersion":{"type":"integer","minimum":0},
        "foundation":{"$ref":"https://cec.local/contracts/m1-v1#/$defs/foundation"},
        "proposal":{"$ref":"https://cec.local/contracts/m1-v1#/$defs/proposal"},
        "artifacts":{"$ref":"https://cec.local/contracts/m1-v1#/$defs/draft/properties/artifacts"},
        "artifactPermission":{"$ref":"https://cec.local/contracts/m1-v1#/$defs/draft/properties/artifactPermission"},
        "brief":{
          "type":"object","additionalProperties":false,"required":["summary","nextAction"],
          "properties":{"summary":{"$ref":"#/$defs/text"},"nextAction":{"$ref":"#/$defs/text"}}
        },
        "ideal":{
          "type":"object","additionalProperties":false,"required":["intention","consequence","feedback","evaluation"],
          "properties":{
            "intention":{
              "type":"object","additionalProperties":false,"required":["goal","statement"],
              "properties":{
                "goal":{"enum":["solo_profit","high_growth","b2b_enterprise","impact","learning","custom","unknown"]},
                "statement":{"$ref":"#/$defs/nullableText"}
              }
            },
            "consequence":{"$ref":"https://cec.local/contracts/m1-v1#/$defs/claim"},
            "feedback":{
              "type":"array","maxItems":6,"items":{
                "type":"object","additionalProperties":false,"required":["summary","source","provenance"],
                "properties":{"summary":{"$ref":"#/$defs/text"},"source":{"$ref":"#/$defs/text"},"provenance":{"const":"founder_reported"}}
              }
            },
            "evaluation":{
              "type":"object","additionalProperties":false,"required":["state","question","unavailableReason","findings"],
              "properties":{
                "state":{"enum":["not_run","requested","available","unavailable"]},
                "question":{"$ref":"#/$defs/nullableText"},
                "unavailableReason":{"$ref":"#/$defs/nullableText"},
                "findings":{
                  "type":"array","maxItems":12,"items":{
                    "type":"object","additionalProperties":false,"required":["topic","statement","kind","source","limitation","provenance"],
                    "properties":{
                      "topic":{"enum":["direct_competitors","manual_substitutes","ai_substitutes","pricing_positioning","praise","complaints","differentiation","growth_signals","problem_discussions","communities","user_habitats","first_user_avenues"]},
                      "statement":{"$ref":"#/$defs/text"},
                      "kind":{"enum":["disclosed_metric","public_proxy","public_observation"]},
                      "limitation":{"$ref":"#/$defs/text"},"provenance":{"const":"synthetic_fixture"},
                      "source":{
                        "type":"object","additionalProperties":false,"required":["title","url","accessedOn"],
                        "properties":{"title":{"$ref":"#/$defs/text"},"url":{"type":"string","pattern":"^https://[^\\s]+$","maxLength":1000},"accessedOn":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"}}
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
